  "query": {
    "language": "ppl",
    "query": "source = [    source = $INDEX    | join ON p_partkey = l_partkey dev.default.lineitem    | join ON s_suppkey = l_suppkey dev.default.supplier    | join ON ps_partkey = l_partkey and ps_suppkey = l_suppkey dev.default.partsupp    | join ON o_orderkey = l_orderkey dev.default.orders    | join ON s_nationkey = n_nationkey dev.default.nation    | where like(p_name, '%green%')    | eval nation = n_name    | eval o_year = year(o_orderdate)    | eval amount = l_extendedprice * (1 - l_discount) - ps_supplycost * l_quantity    | fields nation, o_year, amount  ] as profit| stats sum(amount) as sum_profit by nation, o_year| sort nation, - o_year",
